# Copiar a .env y completar. .env está ignorado por git. Nunca commitear valores reales.

# --- Fabric / ETL (Fase 1 y 2) ---
# Token de la ENTSO-E Transparency Platform. Se pasa como query param securityToken.
# En Fabric vive en la Biblioteca de variables del workspace, no en el notebook.
ENTSOE_TOKEN=

# --- Publicación Fabric -> API (Fase 2 y 3) ---
# Secreto compartido para firmar con HMAC SHA256 el cuerpo del POST de ingestión.
INGEST_HMAC_SECRET=
# URL base de la API a la que Fabric publica las filas nuevas.
INGEST_API_URL=

# --- Capa de servicio (Fase 3) ---
# Cadena de conexión de Supabase Postgres (usada solo por la API, nunca por la interfaz).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lector de datos de la API (Fase 3) ---
# postgres (activo) | fabric-graphql (adaptador alternativo, requiere service principal)
DATA_READER=postgres
FABRIC_GRAPHQL_ENDPOINT=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
