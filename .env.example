# Copiar a .env y completar. .env está ignorado por git. Nunca commitear valores reales.

# --- Fabric / ETL (Fase 1 y 2) ---
# Token de la ENTSO-E Transparency Platform. Se pasa como query param securityToken.
# En Fabric vive en la Biblioteca de variables del workspace, no en el notebook.
ENTSOE_TOKEN=

# --- Publicación Fabric -> API (Fase 3) ---
# Secreto compartido para firmar con HMAC SHA256 el cuerpo del POST /v1/ingest (D18).
# Generar con: openssl rand -hex 32. El mismo valor va en la Biblioteca de variables de Fabric
# (vl_dayahead.INGEST_HMAC_SECRET) y en el entorno de la API (Vercel).
INGEST_HMAC_SECRET=
# URL base de la API a la que Fabric publica (vl_dayahead.INGEST_API_URL), p. ej. https://<proyecto>.vercel.app
INGEST_API_URL=
# Tolerancia de reloj en segundos para la firma (default 300).
INGEST_MAX_SKEW_SECONDS=300

# --- Capa de servicio (Fase 3) ---
# Cadena de conexión de Supabase Postgres (usada solo por la API, nunca por la interfaz).
# Para Vercel usar el pooler en modo transaction (puerto 6543); para migraciones y scripts vale la directa (5432).
DATABASE_URL=
# Puerto local de la API (npm run dev).
PORT=3000
# Límite por defecto de peticiones por minuto por API key (cada key puede tener el suyo en api_keys).
RATE_LIMIT_PER_MINUTE=120
# Origen permitido para CORS en las lecturas (vacío = sin CORS; la interfaz va por su BFF, no lo necesita).
CORS_ORIGIN=

# --- Interfaz web / BFF (Fase 4) ---
# API key de lectura que usa el BFF de la interfaz (creada con: cd api && npm run create-key -- --name web-bff).
WEB_API_KEY=
# URL base de la API que consume el BFF (local: http://localhost:3000).
WEB_API_BASE_URL=http://localhost:3000

# --- Lector de datos de la API (Fase 3) ---
# postgres (activo) | fabric-graphql (adaptador alternativo, requiere service principal)
DATA_READER=postgres
FABRIC_GRAPHQL_ENDPOINT=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# --- Servidor MCP (Fase 5) ---
# API key de solo lectura para el servidor MCP (cd api && npm run create-key -- --name mcp --limit 60).
MCP_API_KEY=
# URL de la API que consume el servidor MCP.
MCP_API_URL=https://dayahead-api.vercel.app
